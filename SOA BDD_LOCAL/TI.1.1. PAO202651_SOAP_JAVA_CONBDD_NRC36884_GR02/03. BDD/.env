# EurekaBank - MySQL (TI Java del GR02)
# Valores compartidos por el grupo, solo para la base local de practica.
# No reutilizar estas claves en ningun otro sistema.

# ---- Contenedor (docker-compose.yml) ----
MYSQL_ROOT_PASSWORD=Eureka.Gr02.Root2026
# Cambiar si el puerto 3306 ya esta ocupado (por ejemplo por otro MySQL)
MYSQL_PORT=3306

# ---- Conexion de los servidores Java a la base ----
# DB_HOST: localhost si la base corre en la misma maquina que el servidor,
#          o la IP de la maquina que tiene la base (ej. 192.168.1.50)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eurekabank
DB_USER=eureka
DB_PASSWORD=admin
DB_URL=jdbc:mysql://localhost:3306/eurekabank?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Guayaquil
