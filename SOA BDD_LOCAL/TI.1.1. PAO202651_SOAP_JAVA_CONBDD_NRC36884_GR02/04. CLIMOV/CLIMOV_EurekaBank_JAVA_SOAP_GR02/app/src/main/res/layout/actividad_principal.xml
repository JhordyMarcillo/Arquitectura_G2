<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/fondo" android:orientation="vertical">

    <FrameLayout android:id="@+id/contenedor" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/navegacion"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/blanco"
        android:elevation="8dp" app:itemActiveIndicatorStyle="@null" app:itemIconTint="@color/navegacion"
        app:itemTextColor="@color/navegacion" app:labelVisibilityMode="labeled" app:menu="@menu/navegacion" />
</LinearLayout>
