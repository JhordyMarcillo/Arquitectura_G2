# EurekaBank - SQL Server (TI .NET del GR02)
# Valores compartidos por el grupo, solo para la base local de practica.
# No reutilizar estas claves en ningun otro sistema.

# ---- Contenedor (docker-compose.yml) ----
MSSQL_SA_PASSWORD=Eureka.Gr02.Sa2026
# Cambiar si el puerto 1433 ya esta ocupado (por ejemplo por otro SQL Server)
MSSQL_PORT=1433

# ---- Conexion de los servidores .NET a la base ----
# DB_HOST: localhost si la base corre en la misma maquina que el servidor,
#          o la IP de la maquina que tiene la base (ej. 192.168.1.50)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=EUREKABANK
DB_USER=eureka
DB_PASSWORD=admin
DB_CONNECTION_STRING=Server=localhost,1433;Database=EUREKABANK;User Id=eureka;Password=admin;TrustServerCertificate=True;
