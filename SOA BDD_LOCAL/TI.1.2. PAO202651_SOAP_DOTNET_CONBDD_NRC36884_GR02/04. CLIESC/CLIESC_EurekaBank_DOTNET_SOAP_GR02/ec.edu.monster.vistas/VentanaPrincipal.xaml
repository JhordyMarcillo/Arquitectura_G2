<Window x:Class="ec.edu.monster.vistas.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EurekaBank" Width="1240" Height="780" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Fondo}"
        FontFamily="{StaticResource Fuente}" Icon="{StaticResource Logo}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================================================== Barra lateral -->
        <Border Background="{StaticResource Marino}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,28,24,32">
                    <Image Source="{StaticResource Logo}" Width="36" Height="36" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="EurekaBank" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Panel de operaciones" Foreground="#94A3B8" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Usuario y cierre de sesion -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,20" Padding="12" CornerRadius="12" Background="{StaticResource MarinoClaro}">
                    <DockPanel>
                        <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource DegradadoMarca}">
                            <TextBlock x:Name="TextoIniciales" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button DockPanel.Dock="Right" ToolTip="Cerrar sesion" Click="BotonCerrarSesion_Click"
                                Cursor="Hand" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="#94A3B8" FontSize="15" />
                        </Button>
                        <StackPanel Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TextoEmpleado" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TextoCodigoEmpleado" Foreground="#94A3B8" FontSize="11" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="CONSULTAS" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="28,0,0,8" />
                    <Button x:Name="MenuCuentas" Style="{StaticResource BotonMenu}" Click="Menu_Click" Tag="Activo">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Width="28" />
                            <TextBlock Text="Cuentas" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MenuMovimientos" Style="{StaticResource BotonMenu}" Click="Menu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Width="28" />
                            <TextBlock Text="Movimientos" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="OPERACIONES" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="28,24,0,8" />
                    <Button x:Name="MenuDeposito" Style="{StaticResource BotonMenu}" Click="Menu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Width="28" />
                            <TextBlock Text="Deposito" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MenuRetiro" Style="{StaticResource BotonMenu}" Click="Menu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Width="28" />
                            <TextBlock Text="Retiro" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MenuTransferencia" Style="{StaticResource BotonMenu}" Click="Menu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Width="28" />
                            <TextBlock Text="Transferencia" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================================================== Contenido -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1" Padding="36,22">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{StaticResource Fondo}" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Verde}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TextoServidor" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource TextoSecundario}" />
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="TextoTituloPagina" Style="{StaticResource TextoTitulo}" />
                        <TextBlock x:Name="TextoSubtituloPagina" Style="{StaticResource TextoSubtitulo}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,28">
                    <ContentControl x:Name="ContenedorPagina" />
                </ScrollViewer>

                <!-- Notificacion flotante -->
                <Border x:Name="Notificacion" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,28"
                        Padding="18,14" CornerRadius="12" Background="{StaticResource Marino}" Effect="{StaticResource Sombra}"
                        Visibility="Collapsed" MaxWidth="420">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="IconoNotificacion" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock x:Name="TextoNotificacion" Foreground="White" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="340" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
