<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginStart="20dp" android:layout_marginTop="6dp" android:layout_marginEnd="20dp" android:layout_marginBottom="6dp"
    android:background="@drawable/fondo_tarjeta" android:elevation="2dp" android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">

    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/fondo_caja_icono"
        android:contentDescription="Cuenta" android:padding="11dp" android:src="@drawable/ic_cuenta_azul" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/texto_codigo" style="@style/TextoValor" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="15sp" />
        <TextView android:id="@+id/texto_cliente" style="@style/TextoSecundario" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end"
        android:orientation="vertical">
        <TextView android:id="@+id/texto_saldo" style="@style/TextoValor" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="15sp" />
        <TextView android:id="@+id/texto_estado" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:background="@drawable/pastilla" android:paddingStart="10dp"
            android:paddingTop="3dp" android:paddingEnd="10dp" android:paddingBottom="3dp" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
