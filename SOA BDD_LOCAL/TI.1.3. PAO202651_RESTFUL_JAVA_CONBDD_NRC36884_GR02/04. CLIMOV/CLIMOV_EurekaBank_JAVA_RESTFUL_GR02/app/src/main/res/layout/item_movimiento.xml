<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="5dp"
    android:background="@drawable/fondo_tarjeta" android:elevation="2dp" android:gravity="center_vertical"
    android:orientation="horizontal" android:padding="14dp">

    <ImageView android:id="@+id/icono" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/circulo"
        android:contentDescription="Tipo" android:padding="9dp" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/texto_descripcion" style="@style/TextoValor" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp" />
        <TextView android:id="@+id/texto_detalle" style="@style/TextoSecundario" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp" />
    </LinearLayout>

    <TextView android:id="@+id/texto_importe" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
