<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EurekaBank" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">@color/primario_suave</item>
        <item name="colorSecondary">@color/primario</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="colorSurface">@color/blanco</item>
        <item name="android:statusBarColor">@color/marino</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/blanco</item>
        <item name="textInputStyle">@style/CampoEureka</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35" xmlns:tools="http://schemas.android.com/tools">true</item>
    </style>

    <style name="CampoEureka" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/primario</item>
        <item name="boxBackgroundColor">@color/blanco</item>
        <item name="hintTextColor">@color/primario</item>
    </style>

    <style name="TextoTitulo">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
    </style>
    <style name="TextoSecundario">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>
    <style name="TextoValor">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
    </style>
    <style name="BotonPrimario" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/primario</item>
    </style>
</resources>
