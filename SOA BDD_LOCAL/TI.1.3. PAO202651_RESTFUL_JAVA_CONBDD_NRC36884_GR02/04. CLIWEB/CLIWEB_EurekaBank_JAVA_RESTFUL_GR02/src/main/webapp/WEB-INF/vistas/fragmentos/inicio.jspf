<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>${titulo} · EurekaBank</title>
    <link rel="icon" href="${pageContext.request.contextPath}/recursos/img/logo.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="${pageContext.request.contextPath}/recursos/css/eurekabank.css" />
</head>
<body>
<div class="app">
    <aside class="lateral">
        <div class="marca">
            <img src="${pageContext.request.contextPath}/recursos/img/logo.svg" alt="" />
            <div><strong>EurekaBank</strong><span>Panel de operaciones</span></div>
        </div>
        <nav class="menu">
            <div class="seccion-menu">CONSULTAS</div>
            <a href="${pageContext.request.contextPath}/cuentas" class="${menu == 'cuentas' ? 'activo' : ''}">${iconos.banco} Cuentas</a>
            <a href="${pageContext.request.contextPath}/movimientos" class="${menu == 'movimientos' ? 'activo' : ''}">${iconos.historial} Movimientos</a>
            <div class="seccion-menu">OPERACIONES</div>
            <a href="${pageContext.request.contextPath}/operacion?tipo=deposito" class="${menu == 'deposito' ? 'activo' : ''}">${iconos.deposito} Deposito</a>
            <a href="${pageContext.request.contextPath}/operacion?tipo=retiro" class="${menu == 'retiro' ? 'activo' : ''}">${iconos.retiro} Retiro</a>
            <a href="${pageContext.request.contextPath}/operacion?tipo=transferencia" class="${menu == 'transferencia' ? 'activo' : ''}">${iconos.transferencia} Transferencia</a>
        </nav>
        <div class="usuario">
            <span class="avatar">${iniciales}</span>
            <div>
                <strong><c:out value="${usuario.nombreEmpleado}" /></strong>
                <small>Empleado ${usuario.codigoEmpleado}</small>
            </div>
            <form method="post" action="${pageContext.request.contextPath}/salir">
                <button type="submit" title="Cerrar sesion">${iconos.salir}</button>
            </form>
        </div>
    </aside>
    <main class="contenido">
        <header class="cabecera">
            <div>
                <h1>${titulo}</h1>
                <p>${subtitulo}</p>
            </div>
            <span class="insignia" title="<c:out value='${servidor}' />">RESTful Java · GR02</span>
        </header>
        <section class="pagina">
            <c:if test="${not empty mensajeError and empty resultado and menu != 'deposito' and menu != 'retiro' and menu != 'transferencia'}">
                <div class="alerta error">${iconos.alerta} <span><c:out value="${mensajeError}" /></span></div>
            </c:if>
