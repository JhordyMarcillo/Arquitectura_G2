<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================== Paleta EurekaBank -->
    <Color x:Key="ColorMarino">#0F172A</Color>
    <Color x:Key="ColorMarinoClaro">#1E293B</Color>
    <Color x:Key="ColorPrimario">#1D4ED8</Color>
    <Color x:Key="ColorPrimarioOscuro">#1E3A8A</Color>

    <SolidColorBrush x:Key="Marino" Color="{StaticResource ColorMarino}" />
    <SolidColorBrush x:Key="MarinoClaro" Color="{StaticResource ColorMarinoClaro}" />
    <SolidColorBrush x:Key="Primario" Color="{StaticResource ColorPrimario}" />
    <SolidColorBrush x:Key="PrimarioHover" Color="#1E40AF" />
    <SolidColorBrush x:Key="PrimarioSuave" Color="#DBEAFE" />
    <SolidColorBrush x:Key="PrimarioOscuroPincel" Color="{StaticResource ColorPrimarioOscuro}" />
    <SolidColorBrush x:Key="Fondo" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Superficie" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Borde" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Texto" Color="#0F172A" />
    <SolidColorBrush x:Key="TextoSecundario" Color="#64748B" />
    <SolidColorBrush x:Key="TextoClaro" Color="#CBD5E1" />
    <SolidColorBrush x:Key="Verde" Color="#059669" />
    <SolidColorBrush x:Key="VerdeSuave" Color="#D1FAE5" />
    <SolidColorBrush x:Key="Rojo" Color="#DC2626" />
    <SolidColorBrush x:Key="RojoSuave" Color="#FEE2E2" />
    <SolidColorBrush x:Key="Ambar" Color="#D97706" />

    <LinearGradientBrush x:Key="DegradadoMarca" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0" />
        <GradientStop Color="#1E3A8A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DegradadoPanel" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#0F172A" Offset="0" />
        <GradientStop Color="#1E3A8A" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="Fuente">Segoe UI Variable Text, Segoe UI</FontFamily>
    <DropShadowEffect x:Key="Sombra" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.10" Color="#0F172A" />

    <!-- =========================================================== Logo (vector) -->
    <DrawingImage x:Key="Logo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource DegradadoMarca}" Geometry="M12,0 H52 A12,12 0 0 1 64,12 V52 A12,12 0 0 1 52,64 H12 A12,12 0 0 1 0,52 V12 A12,12 0 0 1 12,0 Z" />
                <GeometryDrawing Brush="White" Geometry="M18,16 H46 V23 H26 V29 H42 V35 H26 V41 H46 V48 H18 Z" />
                <GeometryDrawing Brush="#93C5FD" Geometry="M48,16 L52,16 L52,48 L48,48 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- =========================================================== Textos -->
    <Style x:Key="TextoTitulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
    </Style>
    <Style x:Key="TextoSubtitulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextoSecundario}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextoEtiqueta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextoSecundario}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- =========================================================== Tarjeta -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Superficie}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect" Value="{StaticResource Sombra}" />
    </Style>

    <!-- =========================================================== Campos de texto -->
    <Style x:Key="CampoBase" TargetType="Control">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#CBD5E1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Height" Value="42" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <ControlTemplate x:Key="PlantillaCampo" TargetType="Control">
        <Border x:Name="Marco" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                          Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Marco" Property="BorderBrush" Value="#94A3B8" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Primario}" />
                <Setter TargetName="Marco" Property="BorderThickness" Value="2" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="TextBox" BasedOn="{StaticResource CampoBase}">
        <Setter Property="Template" Value="{StaticResource PlantillaCampo}" />
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource CampoBase}">
        <Setter Property="Template" Value="{StaticResource PlantillaCampo}" />
    </Style>

    <!-- =========================================================== Botones -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Primario}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource PrimarioHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="Background" Value="{StaticResource PrimarioSuave}" />
        <Setter Property="Foreground" Value="{StaticResource PrimarioOscuroPincel}" />
    </Style>

    <!-- Boton de la barra lateral: se marca con Tag="Activo" -->
    <Style x:Key="BotonMenu" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextoClaro}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="12,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="10" Padding="14,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#1E293B" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Activo">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Primario}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================== Tabla de datos -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Borde}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="RowHeight" Value="42" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F8FAFC" />
        <Setter Property="Foreground" Value="{StaticResource TextoSecundario}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimarioSuave}" />
                <Setter Property="Foreground" Value="{StaticResource Texto}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="EncabezadoDerecha" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style x:Key="CeldaDerecha" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
</ResourceDictionary>
