<UserControl x:Class="ec.edu.monster.vistas.PaginaCuentas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Indicadores -->
        <UniformGrid Columns="3" Margin="-8,0,-8,24">
            <Border Style="{StaticResource Tarjeta}" Margin="8,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimarioSuave}">
                        <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Primario}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Cuentas activas" Style="{StaticResource TextoSubtitulo}" />
                        <TextBlock x:Name="TextoActivas" Text="-" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock x:Name="TextoTotalCuentas" Style="{StaticResource TextoSubtitulo}" FontSize="12" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Tarjeta}" Margin="8,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="44" Height="44" CornerRadius="12" Background="{StaticResource VerdeSuave}">
                        <TextBlock Text="S/" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Verde}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Saldo total en soles" Style="{StaticResource TextoSubtitulo}" />
                        <TextBlock x:Name="TextoSaldoSoles" Text="-" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="Cuentas activas en S/" Style="{StaticResource TextoSubtitulo}" FontSize="12" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Tarjeta}" Margin="8,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="44" Height="44" CornerRadius="12" Background="#FEF3C7">
                        <TextBlock Text="US$" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Ambar}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Saldo total en dolares" Style="{StaticResource TextoSubtitulo}" />
                        <TextBlock x:Name="TextoSaldoDolares" Text="-" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="Cuentas activas en US$" Style="{StaticResource TextoSubtitulo}" FontSize="12" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <!-- Tabla -->
        <Border Style="{StaticResource Tarjeta}" Padding="0">
            <StackPanel>
                <DockPanel Margin="24,20,24,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotonSecundario}" Height="36" Padding="16,0" Click="BotonActualizar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Actualizar" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Listado de cuentas" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Doble clic en una cuenta para ver sus movimientos." Style="{StaticResource TextoSubtitulo}" FontSize="12" />
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="TablaCuentas" MouseDoubleClick="TablaCuentas_MouseDoubleClick" MinHeight="120">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CUENTA" Binding="{Binding Codigo}" Width="120" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding Cliente}" Width="*" />
                        <DataGridTextColumn Header="MONEDA" Binding="{Binding Moneda}" Width="110" />
                        <DataGridTextColumn Header="SALDO" Binding="{Binding SaldoFormateado}" Width="150" FontWeight="SemiBold"
                                            ElementStyle="{StaticResource CeldaDerecha}" HeaderStyle="{StaticResource EncabezadoDerecha}" />
                        <DataGridTemplateColumn Header="ESTADO" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="Etiqueta" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" Background="{StaticResource VerdeSuave}">
                                        <TextBlock x:Name="TextoEtiqueta" Text="{Binding Estado}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Verde}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding EstaActiva}" Value="False">
                                            <Setter TargetName="Etiqueta" Property="Background" Value="#F1F5F9" />
                                            <Setter TargetName="TextoEtiqueta" Property="Foreground" Value="#64748B" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
