<UserControl x:Class="ec.edu.monster.vistas.PaginaOperacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Formulario -->
        <Border Style="{StaticResource Tarjeta}" Padding="32" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource PrimarioSuave}">
                        <TextBlock x:Name="IconoOperacion" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Primario}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TextoTituloFormulario" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="TextoDescripcion" Style="{StaticResource TextoSubtitulo}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="EtiquetaCuenta" Text="CUENTA" Style="{StaticResource TextoEtiqueta}" />
                <TextBox x:Name="CampoCuenta" MaxLength="8" Margin="0,0,0,16" />

                <StackPanel x:Name="BloqueClave">
                    <TextBlock Text="CLAVE DE LA CUENTA" Style="{StaticResource TextoEtiqueta}" />
                    <PasswordBox x:Name="CampoClave" MaxLength="6" Margin="0,0,0,16" />
                </StackPanel>

                <StackPanel x:Name="BloqueDestino">
                    <TextBlock Text="CUENTA DE DESTINO" Style="{StaticResource TextoEtiqueta}" />
                    <TextBox x:Name="CampoDestino" MaxLength="8" Margin="0,0,0,16" />
                </StackPanel>

                <TextBlock Text="IMPORTE" Style="{StaticResource TextoEtiqueta}" />
                <TextBox x:Name="CampoImporte" FontSize="18" FontWeight="SemiBold" />

                <Border Background="{StaticResource Fondo}" CornerRadius="10" Padding="14,10" Margin="0,18,0,0">
                    <DockPanel>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextoSecundario}" VerticalAlignment="Top" Margin="0,2,10,0" />
                        <TextBlock x:Name="TextoNota" Style="{StaticResource TextoSubtitulo}" FontSize="12" />
                    </DockPanel>
                </Border>

                <Button x:Name="BotonRegistrar" Style="{StaticResource BotonPrimario}" Margin="0,22,0,0" Click="BotonRegistrar_Click" IsDefault="True" />
            </StackPanel>
        </Border>

        <!-- Comprobante -->
        <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="32" VerticalAlignment="Top">
            <Grid>
                <StackPanel x:Name="PanelEspera" HorizontalAlignment="Center" Margin="0,40">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                    <TextBlock Text="El comprobante aparecera aqui" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,4" HorizontalAlignment="Center" />
                    <TextBlock Text="Complete el formulario y registre la operacion." Style="{StaticResource TextoSubtitulo}" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="PanelComprobante" Visibility="Collapsed">
                    <Border x:Name="CirculoResultado" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center">
                        <TextBlock x:Name="IconoResultado" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TextoResultado" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock x:Name="TextoMensaje" Style="{StaticResource TextoSubtitulo}" HorizontalAlignment="Center" TextAlignment="Center" />

                    <Border x:Name="DetalleComprobante" BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,18,0,0">
                        <Grid x:Name="TablaDetalle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
