<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vistas="clr-namespace:ec.edu.monster.vistas"
             x:Class="ec.edu.monster.vistas.PaginaOperaciones"
             x:DataType="vistas:PaginaOperaciones"
             BackgroundColor="{StaticResource Fondo}">
    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,28">
            <Label Text="Operaciones" Style="{StaticResource Titulo}" />
            <Label x:Name="TextoDescripcion" Style="{StaticResource Secundario}" Margin="0,2,0,18" />

            <!-- Selector segmentado -->
            <Border BackgroundColor="#E2E8F0" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="4" Margin="0,0,0,16">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                    <Button x:Name="SegmentoDeposito" Text="Deposito" Style="{StaticResource BotonSegmento}" Clicked="Segmento_Clicked" />
                    <Button x:Name="SegmentoRetiro" Grid.Column="1" Text="Retiro" Style="{StaticResource BotonSegmento}" Clicked="Segmento_Clicked" />
                    <Button x:Name="SegmentoTransferencia" Grid.Column="2" Text="Transferencia" Style="{StaticResource BotonSegmento}" Clicked="Segmento_Clicked" />
                </Grid>
            </Border>

            <!-- Formulario -->
            <Border Style="{StaticResource Tarjeta}" Padding="20">
                <VerticalStackLayout>
                    <Label x:Name="EtiquetaCuenta" Text="CUENTA" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource MarcoCampo}">
                        <Entry x:Name="CampoCuenta" Style="{StaticResource Campo}" Keyboard="Numeric" MaxLength="8" Placeholder="8 digitos" />
                    </Border>

                    <VerticalStackLayout x:Name="BloqueClave">
                        <Label Text="CLAVE DE LA CUENTA" Style="{StaticResource Etiqueta}" />
                        <Border Style="{StaticResource MarcoCampo}">
                            <Entry x:Name="CampoClave" Style="{StaticResource Campo}" IsPassword="True" Keyboard="Numeric" MaxLength="6" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="BloqueDestino">
                        <Label Text="CUENTA DE DESTINO" Style="{StaticResource Etiqueta}" />
                        <Border Style="{StaticResource MarcoCampo}">
                            <Entry x:Name="CampoDestino" Style="{StaticResource Campo}" Keyboard="Numeric" MaxLength="8" Placeholder="8 digitos" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="IMPORTE" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource MarcoCampo}">
                        <Entry x:Name="CampoImporte" Style="{StaticResource Campo}" Keyboard="Numeric" Placeholder="0.00"
                               FontSize="18" FontFamily="OpenSansSemibold" />
                    </Border>

                    <Border BackgroundColor="{StaticResource Fondo}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,10">
                        <Label x:Name="TextoNota" Style="{StaticResource Secundario}" FontSize="12" />
                    </Border>

                    <Button x:Name="BotonRegistrar" Style="{StaticResource BotonPrimario}" Margin="0,16,0,0" Clicked="BotonRegistrar_Clicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Comprobante -->
            <Border x:Name="PanelComprobante" Style="{StaticResource Tarjeta}" Padding="22" Margin="0,18,0,0" IsVisible="False">
                <VerticalStackLayout>
                    <Image x:Name="IconoResultado" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" />
                    <Label x:Name="TextoResultado" FontSize="18" FontFamily="OpenSansSemibold" HorizontalOptions="Center"
                           TextColor="{StaticResource Texto}" Margin="0,12,0,2" />
                    <Label x:Name="TextoMensaje" Style="{StaticResource Secundario}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <BoxView HeightRequest="1" Color="{StaticResource Borde}" Margin="0,16,0,8" />
                    <VerticalStackLayout x:Name="ListaDetalle" BindableLayout.ItemsSource="{Binding Detalle}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vistas:LineaComprobante">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                    <Label Text="{Binding Etiqueta}" Style="{StaticResource Secundario}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Valor}" FontFamily="OpenSansSemibold"
                                           FontSize="{Binding TamanoValor}" TextColor="{Binding ColorValor}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
