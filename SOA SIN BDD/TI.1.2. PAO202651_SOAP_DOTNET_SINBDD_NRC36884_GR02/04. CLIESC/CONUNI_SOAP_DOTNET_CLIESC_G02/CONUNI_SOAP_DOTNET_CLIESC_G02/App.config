<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- ÚNICA VARIABLE A CAMBIAR para conectarse desde otra red: reemplaza "localhost" por la IP del equipo donde corre el servidor SOAP -->
        <add key="UrlServicioSOAP" value="http://192.168.0.90:8085/Service1.svc" />
    </appSettings>
</configuration>