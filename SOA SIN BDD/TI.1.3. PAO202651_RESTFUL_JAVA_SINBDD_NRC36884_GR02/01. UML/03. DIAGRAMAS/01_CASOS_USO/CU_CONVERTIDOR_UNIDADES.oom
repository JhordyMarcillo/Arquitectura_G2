<a:Code>C03</a:Code>
<a:CreationDate>1793161761</a:CreationDate>
<a:Creator>Acer</a:Creator>
<a:ModificationDate>1793161761</a:ModificationDate>
<a:Modifier>Acer</a:Modifier>
<a:Comment>metros↔pies, metros↔pulgadas, kilómetros↔millas.</a:Comment>
</o:UseCase>
<o:UseCase Id="o67">
<a:ObjectID>25CCF434-248D-4FD6-950B-272151A63B96</a:ObjectID>
<a:Name>CU-04 Convertir masa (RF-03)</a:Name>
<a:Code>C04</a:Code>
