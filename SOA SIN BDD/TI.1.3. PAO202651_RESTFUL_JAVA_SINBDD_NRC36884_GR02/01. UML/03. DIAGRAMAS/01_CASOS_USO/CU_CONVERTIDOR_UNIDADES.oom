<a:Creator>Acer</a:Creator>
<a:ModificationDate>1793161761</a:ModificationDate>
<a:Modifier>Acer</a:Modifier>
<a:Comment>kilogramos↔libras, gramos↔onzas.</a:Comment>
</o:UseCase>
<o:UseCase Id="o68">
