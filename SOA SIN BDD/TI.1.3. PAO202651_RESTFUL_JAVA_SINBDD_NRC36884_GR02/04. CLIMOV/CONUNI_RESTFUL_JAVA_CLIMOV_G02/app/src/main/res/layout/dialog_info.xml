<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Cómo usar el conversor?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/monster_dark"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleccione el tipo de conversión en las pestañas, ingrese el valor, elija la conversión en la lista y presione &quot;Convertir&quot;. Todas las conversiones se realizan en el servidor (API REST), aquí no se hacen cálculos locales."
        android:textSize="14sp"
        android:textColor="@color/monster_dark"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tipos de conversión disponibles:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/monster_dark"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Temperatura: Celsius, Fahrenheit, Kelvin\n• Longitud: Metros, Pies, Pulgadas, Kilómetros, Millas\n• Peso: Kilogramos, Libras, Gramos, Onzas\n• Volumen: Litros, Galones, Mililitros, Onzas Fluidas\n• Área: m², ft², Hectáreas, Acres"
        android:textSize="14sp"
        android:textColor="@color/monster_dark_gray"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Entendido"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:backgroundTint="@color/monster_blue"
        app:cornerRadius="8dp" />

</LinearLayout>

