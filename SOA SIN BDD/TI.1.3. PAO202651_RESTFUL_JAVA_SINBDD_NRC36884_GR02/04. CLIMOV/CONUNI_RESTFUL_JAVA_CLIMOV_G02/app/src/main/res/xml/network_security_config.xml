<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTP sin TLS permitido hacia cualquier IP: así solo hace falta cambiar SERVER_IP en RetrofitClient.kt -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
