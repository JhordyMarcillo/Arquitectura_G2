<a:Creator>david</a:Creator>
<a:ModificationDate>1793149626</a:ModificationDate>
<a:Modifier>david</a:Modifier>
<a:Comment>Capa controlador de cada cliente: arma las peticiones JSON, agrega Authorization: Bearer &lt;token&gt;, interpreta estado/codigo/mensaje y lanza ExcepcionApi.</a:Comment>
<a:Stereotype>library</a:Stereotype>
</o:Component>
<o:Component Id="o56">
