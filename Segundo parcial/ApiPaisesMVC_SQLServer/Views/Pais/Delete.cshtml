@model ApiPaisesMVC_SQLServer.Models.Pais
@{
    ViewData["Title"] = "Eliminar país";
}
<h2>Eliminar país</h2>
<div class="alert alert-warning">¿Seguro que deseas eliminar este registro?</div>
<dl class="row" style="max-width:600px">
    <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@Model.Nombre</dd>
    <dt class="col-sm-3">Capital</dt><dd class="col-sm-9">@Model.Capital</dd>
    <dt class="col-sm-3">Región</dt><dd class="col-sm-9">@Model.Region</dd>
    <dt class="col-sm-3">Población</dt><dd class="col-sm-9">@Model.Poblacion.ToString("N0")</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-danger">Eliminar</button>
    <a class="btn btn-outline-secondary" asp-action="Lista">Cancelar</a>
</form>
