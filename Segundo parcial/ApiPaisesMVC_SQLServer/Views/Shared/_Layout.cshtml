<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Países MVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Pais" asp-action="Index">Países MVC</a>
                <ul class="navbar-nav flex-row gap-3">
                    <li class="nav-item"><a class="nav-link" asp-controller="Pais" asp-action="Index">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Pais" asp-action="Consultar">Consultar en API</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Pais" asp-action="Lista">Países</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Pais" asp-action="Reportes">Reportes</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Universidad" asp-action="Lista">Universidades</a></li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">&copy; 2026 - Consumo de APIs públicas con ASP.NET Core MVC y SQL Server</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
