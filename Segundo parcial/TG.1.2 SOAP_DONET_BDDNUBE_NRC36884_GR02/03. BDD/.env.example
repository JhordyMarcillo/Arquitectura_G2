# EurekaBank - SQL Server EN LA NUBE (Amazon RDS) - plantilla sin claves.
# Copia este archivo como ".env" y completa los valores (el .env real esta en .gitignore).

DB_HOST=<endpoint-de-la-instancia>.us-east-1.rds.amazonaws.com
DB_PORT=1433
DB_NAME=EUREKABANK

# Login de la aplicacion (lo crea Crea_BD.sql). Usa una clave larga y aleatoria.
DB_USER=eureka
DB_PASSWORD=<clave-del-login-eureka>
EUREKA_PASSWORD=<la-misma-clave>

DB_CONNECTION_STRING=Server=<endpoint>,1433;Database=EUREKABANK;User Id=eureka;Password=<clave-del-login-eureka>;Encrypt=True;TrustServerCertificate=True;

# Administrador de la instancia (solo para Aplicar_BDD_RDS.ps1); su clave va en la
# variable de entorno DB_ADMIN_PASSWORD o en %USERPROFILE%\.aws\rds-arqg2-credenciales.txt
DB_ADMIN_USER=admin